source 'https://rubygems.org'

# DART is a Rails application that only uses Active Record
# (see lib/cosmos/dart/config/application.rb), so it needs railties and
# activerecord rather than all of rails.
gem 'railties', '~> 8.1.4'
gem 'activerecord', '~> 8.1.4'
# DART's database is PostgreSQL 9.5 or later
gem 'pg', '~> 1.6'
# The Dart tool starts the DART processes with childprocess
gem 'childprocess', '~> 5.1'

# Windows does not include zoneinfo files, so bundle the tzinfo-data gem
gem 'tzinfo-data', platforms: :windows
